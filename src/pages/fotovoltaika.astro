---
import BaseLayout from "../layouts/BaseLayout.astro";
import Contact from "../components/Contact.astro";
import { messages } from "../locales";
import { site } from "../site.config";
import { withBase } from "../lib/paths";
---

<BaseLayout
  title={site.seo.fotovoltaikaTitle}
  description={site.seo.fotovoltaikaDescription}
>
  <section class="hero page">
    <div class="hero__media">
      <img src={withBase("images/hero-fv-panels.jpg")} alt={messages.pvPage.imageAlt} />
    </div>
    <div class="hero__shade"></div>
    <div class="wrap">
      <p class="eyebrow">{messages.nav.offer}</p>
      <h1>{messages.pvPage.title}</h1>
      <p class="lede">{messages.pvPage.lede}</p>
      <div class="hero__actions">
        <a class="button" href={withBase("/#poptavka")}>{messages.cta.inquiry}</a>
        <a class="button secondary" href={withBase("/tepelna-cerpadla/")}>{messages.nav.hp}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2">
      {
        messages.pvPage.audiences.map((item) => (
          <article class="card">
            <h2>{item.title}</h2>
            <p>{item.body}</p>
            <p class="muted">{item.note}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2>{messages.pvPage.processTitle}</h2>
      <div class="grid-3">
        {
          messages.pvPage.steps.map((step) => (
            <article class="card">
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Contact />
</BaseLayout>
