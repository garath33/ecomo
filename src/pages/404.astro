---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site.config";
import { withBase } from "../lib/paths";
---

<BaseLayout title={`Stránka nenalezena | ${site.legalName}`}>
  <section class="section">
    <div class="wrap">
      <h1>Tady nic není</h1>
      <p class="lede">Stránka neexistuje nebo se přesunula.</p>
      <a class="button" href={withBase()}>Zpět na úvod</a>
    </div>
  </section>
</BaseLayout>
