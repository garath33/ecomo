---
import BaseLayout from "../layouts/BaseLayout.astro";
import Contact from "../components/Contact.astro";
import { messages } from "../locales";
import { site } from "../site.config";
import { withBase } from "../lib/paths";
---

<BaseLayout title={site.seo.tepelnaTitle} description={site.seo.tepelnaDescription}>
  <section class="hero page hero--open">
    <div class="hero__media">
      <img src={withBase("images/nabidka-tc.jpg")} alt={messages.offer.hp.imageAlt} />
    </div>
    <div class="hero__shade"></div>
    <div class="wrap">
      <p class="eyebrow">{messages.nav.offer}</p>
      <h1>{messages.hpPage.title}</h1>
      <p class="lede">{messages.hpPage.lede}</p>
      <div class="hero__actions">
        <a class="button" href={withBase("/#poptavka")}>{messages.cta.inquiry}</a>
        <a class="button secondary" href={withBase("/fotovoltaika/")}>{messages.nav.pv}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2">
      <article>
        <h2>{messages.hpPage.whyTitle}</h2>
        {messages.hpPage.why.map((paragraph) => <p>{paragraph}</p>)}
      </article>
      <article class="card">
        <h3>{messages.hpPage.coversTitle}</h3>
        <ul class="list">
          {messages.hpPage.covers.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2>{messages.hpPage.choiceTitle}</h2>
      <p class="lede">{messages.hpPage.choiceLede}</p>
      <div class="grid-3">
        {
          messages.hpPage.choices.map((choice) => (
            <article class="card">
              <h3>{choice.title}</h3>
              <p>{choice.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{messages.hpPage.priceTitle}</h2>
      <p>{messages.hpPage.price}</p>
    </div>
  </section>

  <Contact />
</BaseLayout>
