---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PreviewBanner from "../components/PreviewBanner.astro";
import JsonLd from "../components/JsonLd.astro";
import { site } from "../site.config";
import { withBase } from "../lib/paths";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.seo.homeDescription } = Astro.props;
const pageTitle = title ?? site.seo.homeTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase("images/zakazka-pristresek.jpg"), Astro.site).href;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.legalName} />
    <meta name="geo.region" content="CZ-ST" />
    <meta name="geo.placename" content={`${site.address.line2}, ${site.address.city}`} />
    <meta name="geo.position" content={`${site.geo.latitude};${site.geo.longitude}`} />
    <meta name="ICBM" content={`${site.geo.latitude}, ${site.geo.longitude}`} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Fotovoltaický přístřešek ecomo" />
    <meta property="og:site_name" content={site.legalName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <JsonLd pageUrl={canonical.href} image={ogImage} />
  </head>
  <body>
    <a class="skip-link" href="#obsah">Přeskočit na obsah</a>
    <PreviewBanner />
    <Header />
    <main id="obsah">
      <slot />
    </main>
    <Footer />
    <script>
      function scrollToHash() {
        const id = window.location.hash.replace("#", "");
        if (!id) return;
        document.getElementById(id)?.scrollIntoView({ behavior: "smooth", block: "start" });
      }

      window.addEventListener("hashchange", scrollToHash);
      window.addEventListener("load", scrollToHash);
    </script>
  </body>
</html>
