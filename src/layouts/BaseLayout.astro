---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PreviewBanner from "../components/PreviewBanner.astro";
import JsonLd from "../components/JsonLd.astro";
import { messages } from "../locales";
import { site } from "../site.config";
import { isPreview, withBase } from "../lib/paths";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.seo.homeDescription } = Astro.props;
const pageTitle = title ?? site.seo.homeTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase("images/hero-fv-panels.jpg"), Astro.site).href;
---

<!doctype html>
<html lang={messages.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.legalName} />
    <meta name="geo.region" content="CZ-ST" />
    <meta name="geo.placename" content={`${site.address.line2}, ${site.address.city}`} />
    <meta name="geo.position" content={`${site.geo.latitude};${site.geo.longitude}`} />
    <meta name="ICBM" content={`${site.geo.latitude}, ${site.geo.longitude}`} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={messages.ogLocale} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={messages.ogImageAlt} />
    <meta property="og:site_name" content={site.legalName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {isPreview() && <meta name="robots" content="noindex, nofollow" />}
    <JsonLd pageUrl={canonical.href} image={ogImage} />
  </head>
  <body>
    <a class="skip-link" href="#obsah">{messages.skipToContent}</a>
    <PreviewBanner />
    <Header />
    <main id="obsah">
      <slot />
    </main>
    <Footer />
    <script>
      function scrollToElement(element: HTMLElement) {
        const marginTop = Number.parseFloat(getComputedStyle(element).scrollMarginTop) || 0;
        const top = element.getBoundingClientRect().top + window.scrollY - marginTop;
        const behavior = window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";
        window.scrollTo({ top: Math.max(0, top), behavior });
      }

      function scrollToHash() {
        const id = window.location.hash.replace("#", "");
        if (!id) return;
        const element = document.getElementById(id);
        if (!element) return;
        scrollToElement(element);
      }

      function isInquiryHash(hash: string): boolean {
        return hash === "#kontakt" || hash === "#poptavka";
      }

      document.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest("a[href]");
        if (!(link instanceof HTMLAnchorElement) || link.target === "_blank") return;
        const url = new URL(link.href, window.location.href);
        if (url.origin !== window.location.origin || !isInquiryHash(url.hash)) return;
        const intro = document.getElementById("kontakt");
        if (!intro) return;
        event.preventDefault();
        const next = `${window.location.pathname}${window.location.search}#kontakt`;
        if (`${window.location.pathname}${window.location.search}${window.location.hash}` !== next) {
          history.pushState(null, "", next);
        }
        scrollToElement(intro);
      });

      window.addEventListener("hashchange", scrollToHash);
      window.addEventListener("load", scrollToHash);
    </script>
  </body>
</html>
