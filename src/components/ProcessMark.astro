---
interface Props {
  name: "smlouva" | "administrativa" | "realizace";
}

const { name } = Astro.props;
---

<span class="step__mark" aria-hidden="true">
  {
    name === "smlouva" && (
      <svg viewBox="0 0 72 72" fill="none">
        <rect x="6" y="6" width="60" height="60" rx="14" fill="var(--brand)" stroke="currentColor" stroke-width="2.4" />
        <path
          d="M17.5 22.8c1.2-1.6 3.1-2.5 5.1-2.5h3.6c1.5 0 2.9 1 3.3 2.5l1.7 6c.4 1.4-.1 2.9-1.2 3.8l-3.2 2.5c2.4 5.6 6.8 10 12.4 12.4l2.5-3.2c.9-1.1 2.4-1.6 3.8-1.2l6 1.7c1.5.4 2.5 1.8 2.5 3.3v3.6c0 2-.9 3.9-2.5 5.1-2.8 2-6.4 2.7-10.4 1.9-12.8-2.4-22.8-12.4-25.2-25.2-.8-4-.1-7.6 1.6-10.7z"
          fill="#ffffff"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linejoin="round"
        />
        <path
          d="M38 19.5a13.5 13.5 0 0 1 13.5 13.5M38 26.5a6.5 6.5 0 0 1 6.5 6.5"
          stroke="currentColor"
          stroke-width="2.6"
          stroke-linecap="round"
        />
      </svg>
    )
  }
  {
    name === "administrativa" && (
      <svg viewBox="0 0 72 72" fill="none">
        <rect x="6" y="6" width="60" height="60" rx="14" fill="var(--brand)" stroke="currentColor" stroke-width="2.4" />
        <rect
          x="25"
          y="12"
          width="26"
          height="34"
          rx="2.5"
          transform="rotate(10 38 29)"
          fill="#ffffff"
          stroke="currentColor"
          stroke-width="2.2"
        />
        <rect
          x="21"
          y="14"
          width="26"
          height="34"
          rx="2.5"
          transform="rotate(4 34 31)"
          fill="#f3f3f0"
          stroke="currentColor"
          stroke-width="2.2"
        />
        <rect
          x="17"
          y="16"
          width="26"
          height="34"
          rx="2.5"
          transform="rotate(-3 30 33)"
          fill="#ffffff"
          stroke="currentColor"
          stroke-width="2.2"
        />
        <path
          d="M16 20h20l7 7v27a2.5 2.5 0 0 1-2.5 2.5h-24.5A2.5 2.5 0 0 1 13.5 54V22.5A2.5 2.5 0 0 1 16 20z"
          fill="#ffffff"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linejoin="round"
        />
        <path d="M36 20v7h7" fill="var(--brand)" stroke="currentColor" stroke-width="2.3" stroke-linejoin="round" />
        <path
          d="M19 31h14M19 36.5h18M19 42h15M19 47.5h9"
          stroke="currentColor"
          stroke-width="2.3"
          stroke-linecap="round"
        />
        <circle cx="35.5" cy="48.5" r="4.2" fill="var(--brand)" stroke="currentColor" stroke-width="2" />
        <path d="M33.7 48.5l1.3 1.3 2.5-2.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )
  }
  {
    name === "realizace" && (
      <svg viewBox="0 0 72 72" fill="none">
        <rect x="6" y="6" width="60" height="60" rx="14" fill="var(--brand)" stroke="currentColor" stroke-width="2.4" />
        <path
          d="M26 26.5v4.2a10 10 0 0 0 20 0v-4.2"
          fill="#ffffff"
          stroke="currentColor"
          stroke-width="2.3"
        />
        <circle cx="32.2" cy="30" r="1.25" fill="currentColor" />
        <circle cx="39.8" cy="30" r="1.25" fill="currentColor" />
        <path d="M33.2 34.6c1.5 1 4.1 1 5.6 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <path
          d="M23.5 25c0-6.8 5.6-12 12.5-12s12.5 5.2 12.5 12"
          fill="#ffffff"
          stroke="currentColor"
          stroke-width="2.3"
        />
        <path d="M33.5 13.3v11.2h5V13.3" fill="var(--brand)" stroke="currentColor" stroke-width="2" />
        <path d="M20 25.5h32" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" />
        <rect
          x="24"
          y="48.2"
          width="31"
          height="6.6"
          rx="3.3"
          fill="#ffffff"
          stroke="currentColor"
          stroke-width="2.2"
        />
        <circle cx="51" cy="51.5" r="1.3" fill="currentColor" />
        <circle
          cx="22.5"
          cy="51.5"
          r="7.2"
          fill="#ffffff"
          stroke="currentColor"
          stroke-width="2.3"
        />
        <polygon
          points="22.5,47.2 26.2,49.3 26.2,53.7 22.5,55.8 18.8,53.7 18.8,49.3"
          fill="var(--brand)"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
</span>

<style>
  .step__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 4.5rem;
    color: var(--ink);
    flex-shrink: 0;
  }

  .step__mark svg {
    width: 100%;
    height: 100%;
    display: block;
    filter: drop-shadow(3px 3px 0 var(--ink));
  }
</style>
