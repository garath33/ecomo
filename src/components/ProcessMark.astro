---
interface Props {
  name: "smlouva" | "administrativa" | "realizace";
}

const { name } = Astro.props;
---

<span class="step__mark" aria-hidden="true">
  {
    name === "smlouva" && (
      <svg viewBox="0 0 72 72" fill="none">
        <rect x="6" y="6" width="60" height="60" rx="14" fill="var(--brand)" stroke="currentColor" stroke-width="2.4" />
        <path
          d="M31 15h23a5 5 0 0 1 5 5v14a5 5 0 0 1-5 5H41l-7.5 6.2V39H31a5 5 0 0 1-5-5V20a5 5 0 0 1 5-5z"
          fill="#ffffff"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linejoin="round"
        />
        <path d="M32.5 23.5h18M32.5 29.5h12.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
        <path
          d="M15.4 25.2c1.1-1.5 2.8-2.4 4.6-2.4h3.2c1.4 0 2.6.9 2.9 2.2l1.6 5.4c.3 1.2-.1 2.6-1.1 3.4l-2.9 2.2c2.1 5 6 8.9 11 11l2.2-2.9c.8-1 2.2-1.4 3.4-1.1l5.4 1.6c1.3.3 2.2 1.5 2.2 2.9v3.2c0 1.8-.9 3.5-2.4 4.6-2.5 1.8-5.8 2.4-9.4 1.7-11.5-2.1-20.4-11-22.5-22.5-.7-3.6-.1-6.9 1.8-9.3z"
          fill="#111111"
          stroke="#111111"
          stroke-width="1.8"
          stroke-linejoin="round"
        />
        <path
          d="M20.2 27.6h2.2l1.1 3.7-2.2 1.7a16.8 16.8 0 0 0 9.4 9.4l1.7-2.2 3.7 1.1v2.2c0 .9-.7 1.7-1.6 1.9-8.1 1.1-15.4-6.2-14.3-14.3.2-.9 1-1.5 2-1.5z"
          fill="#ffffff"
        />
      </svg>
    )
  }
  {
    name === "administrativa" && (
      <svg viewBox="0 0 72 72" fill="none">
        <rect x="6" y="6" width="60" height="60" rx="14" fill="var(--brand)" stroke="currentColor" stroke-width="2.4" />
        <rect
          x="25"
          y="12"
          width="26"
          height="34"
          rx="2.5"
          transform="rotate(10 38 29)"
          fill="#ffffff"
          stroke="currentColor"
          stroke-width="2.2"
        />
        <rect
          x="21"
          y="14"
          width="26"
          height="34"
          rx="2.5"
          transform="rotate(4 34 31)"
          fill="#f3f3f0"
          stroke="currentColor"
          stroke-width="2.2"
        />
        <rect
          x="17"
          y="16"
          width="26"
          height="34"
          rx="2.5"
          transform="rotate(-3 30 33)"
          fill="#ffffff"
          stroke="currentColor"
          stroke-width="2.2"
        />
        <path
          d="M16 20h20l7 7v27a2.5 2.5 0 0 1-2.5 2.5h-24.5A2.5 2.5 0 0 1 13.5 54V22.5A2.5 2.5 0 0 1 16 20z"
          fill="#ffffff"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linejoin="round"
        />
        <path d="M36 20v7h7" fill="var(--brand)" stroke="currentColor" stroke-width="2.3" stroke-linejoin="round" />
        <path
          d="M19 31h14M19 36.5h18M19 42h15M19 47.5h9"
          stroke="currentColor"
          stroke-width="2.3"
          stroke-linecap="round"
        />
        <circle cx="35.5" cy="48.5" r="4.2" fill="var(--brand)" stroke="currentColor" stroke-width="2" />
        <path d="M33.7 48.5l1.3 1.3 2.5-2.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )
  }
  {
    name === "realizace" && (
      <svg viewBox="0 0 72 72" fill="none">
        <rect x="6" y="6" width="60" height="60" rx="14" fill="var(--brand)" stroke="currentColor" stroke-width="2.4" />
        <path
          d="M13 56c1.8-6.6 7.5-10.8 15.5-10.8S42.2 49.4 44 56"
          fill="#111111"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path d="M23.5 45.6L28.5 53l5-7.4" fill="#ffffff" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        <path
          d="M19.5 29v4a9 9 0 0 0 18 0v-4"
          fill="#ffffff"
          stroke="currentColor"
          stroke-width="2.4"
        />
        <circle cx="25.2" cy="32.2" r="1.2" fill="currentColor" />
        <circle cx="31.8" cy="32.2" r="1.2" fill="currentColor" />
        <path d="M26 36.6c1.5 1.1 3.5 1.1 5 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <path
          d="M16.5 27c0-6.8 5.2-12 12-12s12 5.2 12 12"
          fill="#ffffff"
          stroke="currentColor"
          stroke-width="2.4"
        />
        <path d="M26 15.2v11.3h5V15.2" fill="var(--brand)" stroke="currentColor" stroke-width="2" />
        <path d="M13.5 27.5h30" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        <path
          d="M54.2 18.5a7.2 7.2 0 0 0-8.6 9.8l-8.4 14.6a3.4 3.4 0 1 0 4.8 4.8l8.4-8.4a7.2 7.2 0 0 0 9.8-8.5l-4.1 4.1-3.7-1-1-3.7 2.8-11.7z"
          fill="#ffffff"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linejoin="round"
        />
        <circle cx="39.6" cy="45.2" r="1.3" fill="currentColor" />
      </svg>
    )
  }
</span>

<style>
  .step__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 4.5rem;
    color: var(--ink);
    flex-shrink: 0;
  }

  .step__mark svg {
    width: 100%;
    height: 100%;
    display: block;
    filter: drop-shadow(3px 3px 0 var(--ink));
  }
</style>
