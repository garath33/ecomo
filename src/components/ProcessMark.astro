---
interface Props {
  name: "smlouva" | "administrativa" | "realizace";
}

const { name } = Astro.props;
---

<span class="step__marks" aria-hidden="true">
  {
    name === "smlouva" && (
      <>
        <span class="step__mark">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round">
            <path d="M8.1 4.2h2.2c.4 0 .7.3.8.6l.7 2.5a.9.9 0 0 1-.4 1L9.8 9.4a8.6 8.6 0 0 0 4.8 4.8l1.1-1.6a.9.9 0 0 1 1-.4l2.5.7c.3.1.6.4.6.8v2.2c0 .6-.5 1.1-1.1 1.2-6.4.7-11.2-4.1-10.5-10.5.1-.6.6-1.1 1.2-1.2z" />
          </svg>
        </span>
        <span class="step__mark">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round">
            <path d="M3.4 4.3h9.6v6.3H7.6L5.2 12.8V10.6H3.4z" />
            <path d="M10.6 9.2h10v6.1h-3.6V17.6l-2.4-2.3h-4z" fill="var(--brand)" />
          </svg>
        </span>
        <span class="step__mark">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round">
            <path d="M5.4 7.2V5h4.2v2.2" />
            <rect x="2.6" y="7.2" width="11.2" height="11.2" />
            <path d="M13.8 10.6h7.4v2.5h-7.4" fill="currentColor" stroke="none" />
            <path d="M21.2 10.6v3.8" />
            <path d="M15.6 10.6v1.3M17.3 10.6v.8M19 10.6v1.3M20.5 10.6v.8" />
          </svg>
        </span>
      </>
    )
  }
  {
    name === "administrativa" && (
      <span class="step__mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="miter">
          <path d="M11 2.75h9.25V13" />
          <path d="M8.15 5.15h9.25V15.6" fill="var(--brand)" />
          <path d="M5.3 7.55h9.25V20.9H5.3z" fill="var(--brand)" />
          <path d="M7.45 11.7h5" />
          <path d="M7.45 14.7h3.4" />
        </svg>
      </span>
    )
  }
  {
    name === "realizace" && (
      <span class="step__mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round">
          <path d="M4.2 12.2a4.6 4.6 0 0 1 9.2 0" />
          <path d="M3 12.2h11.6" />
          <path d="M5.8 12.6v2.8a3 2.4 0 0 0 6 0v-2.8" />
          <path fill="currentColor" stroke="none" d="M14.7 2.6v3.6h1.7V21h1.6V6.2H21V2.6h-1.6v1.9h-1.9V2.6z" />
        </svg>
      </span>
    )
  }
</span>

<style>
  .step__marks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .step__mark {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--brand);
    color: var(--ink);
    border-radius: var(--radius);
  }

  .step__mark svg {
    width: 1.5rem;
    height: 1.5rem;
    display: block;
  }
</style>
