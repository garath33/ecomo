---
import { messages } from "../locales";
import { withBase } from "../lib/paths";
---

<section class="section" id="nabidka" data-testid="offer">
  <div class="wrap">
    <p class="eyebrow">{messages.nav.offer}</p>
    <h2>{messages.offer.title}</h2>
    <p class="lede">{messages.offer.lede}</p>
    <div class="grid-2">
      <article class="card panel">
        <div class="media">
          <img src={withBase("images/nabidka-fv.jpg")} alt={messages.offer.pv.imageAlt} />
        </div>
        <h3>{messages.offer.pv.title}</h3>
        <p>{messages.offer.pv.body}</p>
        <ul class="list muted">
          {messages.offer.pv.points.map((point) => <li>{point}</li>)}
        </ul>
        <a class="button ghost" href={withBase("/fotovoltaika/")}>{messages.cta.morePv}</a>
      </article>
      <article class="card panel">
        <div class="media">
          <img src={withBase("images/nabidka-tc.jpg")} alt={messages.offer.hp.imageAlt} />
        </div>
        <h3>{messages.offer.hp.title}</h3>
        <p>{messages.offer.hp.body}</p>
        <ul class="list muted">
          {messages.offer.hp.points.map((point) => <li>{point}</li>)}
        </ul>
        <a class="button ghost" href={withBase("/tepelna-cerpadla/")}>{messages.cta.moreHp}</a>
      </article>
    </div>
  </div>
</section>
