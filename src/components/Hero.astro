---
import { site } from "../site.config";
import { withBase } from "../lib/paths";
---

<section class="hero" data-testid="hero">
  <div class="hero__media">
    <img
      src={withBase("images/zakazka-pristresek.jpg")}
      alt="Fotovoltaický přístřešek ecomo na ocelové konstrukci"
    />
  </div>
  <div class="hero__shade"></div>
  <div class="wrap">
    <p class="eyebrow">Fotovoltaika a tepelná čerpadla</p>
    <h1>Smysluplné elektrárny na míru, s rozumnou cenou</h1>
    <p class="lede">
      {site.approach} Nejdřív si poslechneme, co dům a rodina potřebují, spočítáme, jestli se to
      vyplatí — a teprve potom stavíme.
    </p>
    <div class="hero__actions">
      <a class="button" href={withBase("/#poptavka")}>Kontaktujte nás</a>
    </div>
    <div class="hero__meta">
      <div>
        <strong>Na klíč</strong>
        návrh, dotace, montáž, připojení
      </div>
      <div>
        <strong>Osobně</strong>
        jednáte s {site.person}
      </div>
      <div>
        <strong>Dva obory</strong>
        FVE i tepelná čerpadla
      </div>
    </div>
  </div>
</section>
