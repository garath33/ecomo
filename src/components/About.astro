---
import { messages } from "../locales";
import { site } from "../site.config";
import { withBase } from "../lib/paths";
---

<section class="section" data-testid="about">
  <div class="wrap about-copy">
    <p class="eyebrow">{messages.nav.about}</p>
    <h1>{messages.about.title}</h1>
    <p class="lede">
      {site.legalName} tvoří {site.person}, {site.specialty.toLowerCase()} a {site.role.toLowerCase()}.
      {messages.about.afterNames}
    </p>
    {messages.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <ul class="list muted">
      {messages.about.points.map((point) => <li>{point}</li>)}
    </ul>
    <a class="button" href={withBase("/#poptavka")}>{messages.cta.contactUs}</a>
  </div>
</section>
