---
import { messages } from "../locales";
import { projects } from "../site.config";
import { withBase } from "../lib/paths";
---

<section class="section alt" id="zakazky" data-testid="projects">
  <div class="wrap">
    <p class="eyebrow">{messages.projects.eyebrow}</p>
    <h2>{messages.projects.title}</h2>
    <p class="lede">{messages.projects.lede}</p>
    <div class="grid-2">
      {
        projects.map((project) => (
          <article class="card">
            <div class="media">
              <img src={withBase(project.image)} alt={project.alt} />
            </div>
            <h3>{project.title}</h3>
            <p class="muted">{project.summary}</p>
            <span class="note">{messages.projects.done}</span>
          </article>
        ))
      }
    </div>
  </div>
</section>
