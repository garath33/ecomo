---
import { inquiryFormAction } from "../lib/inquiry";
import { messages } from "../locales";
import { inquiryTopics, site } from "../site.config";
---

<form
  class="form"
  data-inquiry-form
  action={inquiryFormAction()}
  method="POST"
  novalidate
>
  <label>
    {messages.form.name}
    <input type="text" name="name" autocomplete="name" required />
    <span class="error" data-error-for="name"></span>
  </label>
  <label>
    {messages.form.phone}
    <input type="tel" name="phone" autocomplete="tel" inputmode="tel" required />
    <span class="error" data-error-for="phone"></span>
  </label>
  <label>
    {messages.form.email}
    <input type="email" name="email" autocomplete="email" required />
    <span class="error" data-error-for="email"></span>
  </label>
  <label>
    {messages.form.topic}
    <select name="topic" required>
      <option value="">{messages.form.topicEmpty}</option>
      {inquiryTopics.map((topic) => <option value={topic.value}>{topic.label}</option>)}
    </select>
    <span class="error" data-error-for="topic"></span>
  </label>
  <label>
    {messages.form.message}
    <textarea name="message" required></textarea>
    <span class="error" data-error-for="message"></span>
  </label>
  <label class="hp" aria-hidden="true">
    {messages.form.honeypot}
    <input type="text" name="_honey" tabindex="-1" autocomplete="off" />
  </label>
  <label class="hp" aria-hidden="true">
    <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
  </label>
  <input type="hidden" name="access_key" value={site.web3formsAccessKey} />
  <input type="hidden" name="from_name" value={site.legalName} />
  <input type="hidden" name="subject" value={messages.cta.inquiry} />
  <input type="hidden" name="redirect" value="https://ecomo.cz/?poptavka=odeslana#poptavka" />
  <p class="muted">
    {messages.form.consent}
    {site.email}.
  </p>
  <span class="error" data-error-for="form"></span>
  <button class="button" type="submit">{messages.form.submit}</button>
  <div class="form-status" data-inquiry-status role="status" aria-live="polite" tabindex="-1" hidden></div>
</form>

<script>
  import "../scripts/inquiry";
</script>
