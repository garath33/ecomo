---
import InquiryForm from "./InquiryForm.astro";
import { messages } from "../locales";
import { site } from "../site.config";
---

<section class="section" data-testid="contact">
  <div class="wrap contact-stack">
    <div data-testid="contact-intro">
      <h2>{messages.contact.title}</h2>
      <p class="lede">
        {messages.contact.beforePhone}
        <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
        {messages.contact.afterPhone}
      </p>
    </div>
    <div class="card" id="poptavka">
      <h3>{messages.cta.inquiry}</h3>
      <InquiryForm />
    </div>
  </div>
</section>
