---
import Logo from "./Logo.astro";
import { messages } from "../locales";
import { site } from "../site.config";
import { withBase } from "../lib/paths";
---

<footer class="site-footer" id="kontakt" data-testid="site-footer">
  <div class="wrap">
    <h2 class="eyebrow">{messages.nav.contact}</h2>
    <div class="site-footer__grid">
      <div>
        <a class="logo" href={withBase()}><Logo onDark /></a>
        <p>
          {site.legalName}<br />
          {site.address.line1}, {site.address.line2}<br />
          {site.address.zip} {site.address.city}
        </p>
        <p>{messages.footer.ico} {site.ico} · {messages.footer.dic} {site.dic}</p>
      </div>
      <div>
        <p>
          <strong>{site.person}</strong><br />
          {site.specialty}<br />
          {site.role}
        </p>
        <p>
          <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a><br />
          <a href={`mailto:${site.email}`}>{site.email}</a><br />
          <a href={site.web}>{site.webDisplay}</a>
        </p>
      </div>
      <div>
        <p>
          <a href={withBase("/#poptavka")}>{messages.cta.inquiry}</a><br />
          <a href={withBase("/fotovoltaika/")}>{messages.nav.pv}</a><br />
          <a href={withBase("/tepelna-cerpadla/")}>{messages.nav.hp}</a>
        </p>
      </div>
    </div>
  </div>
</footer>
