{
  "name": "ecomo",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Prezentační web Ecomo s.r.o. — fotovoltaika a tepelná čerpadla",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^5.13.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.6.3",
    "eslint": "^9.36.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^16.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
